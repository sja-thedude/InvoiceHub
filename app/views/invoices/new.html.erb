<% content_for :page_title, "New Invoice" %>
<div class="space-y-5">
  <%= link_to invoices_path, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to invoices<% end %>
  <h2 class="text-2xl font-bold text-slate-900">New Invoice</h2>
  <% if current_user.clients.none? %>
    <%= render "shared/empty_state", title: "Add a client first", body: "You need at least one client before creating an invoice.", icon: :users, action_label: "Add client", action_path: new_client_path %>
  <% else %>
    <%= render "form", invoice: @invoice %>
  <% end %>
</div>
