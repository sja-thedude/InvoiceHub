<%= form_with model: invoice, data: { controller: "line-items", "line-items-currency-value": (invoice.currency.presence || current_user.default_currency) } do |f| %>
  <%= render "shared/form_errors", model: invoice %>

  <div class="grid lg:grid-cols-3 gap-6">
    <%# Left: details + line items %>
    <div class="lg:col-span-2 space-y-6">
      <%# Client / project / dates %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="font-semibold text-slate-900 mb-4">Details</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= f.label :client_id, "Client", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.collection_select :client_id, current_user.clients.alphabetical, :id, :name, { prompt: "Select a client" }, required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= f.label :project_id, "Project (optional)", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.collection_select :project_id, current_user.projects.includes(:client).order(:name), :id, ->(p) { "#{p.name} — #{p.client.name}" }, { include_blank: "No project" }, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= f.label :issue_date, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.date_field :issue_date, value: invoice.issue_date || Date.current, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= f.label :due_date, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.date_field :due_date, value: invoice.due_date || (Date.current + current_user.payment_terms_days.to_i.days), class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= f.label :currency, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.select :currency, currency_options, { selected: invoice.currency.presence || current_user.default_currency }, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.select :status, Invoice.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>
      </div>

      <%# Line items %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-semibold text-slate-900">Line items</h3>
          <% if invoice.project_id.present? %>
            <%= link_to "Import unbilled time", import_time_invoice_path(invoice), data: { turbo_method: :post }, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" if invoice.persisted? %>
          <% end %>
        </div>

        <div class="hidden sm:grid grid-cols-12 gap-2 px-2 pb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
          <div class="col-span-6">Description</div>
          <div class="col-span-2 text-right">Qty</div>
          <div class="col-span-2 text-right">Unit price</div>
          <div class="col-span-1 text-right">Amount</div>
          <div class="col-span-1"></div>
        </div>

        <div data-line-items-target="rows">
          <%= f.fields_for :invoice_items do |item| %>
            <%= render "line_item_fields", item: item %>
          <% end %>
        </div>

        <%# Template for new rows %>
        <template data-line-items-target="template">
          <%= f.fields_for :invoice_items, InvoiceItem.new, child_index: "NEW_RECORD" do |item| %>
            <%= render "line_item_fields", item: item %>
          <% end %>
        </template>

        <button type="button" data-action="line-items#add" class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-dashed border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:border-indigo-400 hover:text-indigo-600 transition">
          <span class="w-4 h-4"><%= icon_svg(:plus, classes: "w-4 h-4").html_safe %></span> Add line item
        </button>
      </div>

      <%# Notes & terms %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :notes, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :notes, rows: 3, placeholder: "Visible to the client", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :terms, "Payment terms", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_area :terms, rows: 3, placeholder: "e.g. Payment due within 30 days", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
      </div>
    </div>

    <%# Right: totals + recurring %>
    <div class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:sticky lg:top-20">
        <h3 class="font-semibold text-slate-900 mb-4">Summary</h3>

        <div class="space-y-3 text-sm">
          <div class="flex justify-between"><span class="text-slate-500">Subtotal</span><span class="font-medium text-slate-900" data-line-items-target="subtotal">—</span></div>
          <div class="flex justify-between items-center">
            <%= f.label :discount, "Discount", class: "text-slate-500" %>
            <%= f.number_field :discount, step: "0.01", data: { "line-items-target": "discount", action: "input->line-items#recalculate" }, class: "w-24 rounded-lg border-slate-300 text-sm text-right focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div class="flex justify-between items-center">
            <%= f.label :tax_rate, "Tax rate (%)", class: "text-slate-500" %>
            <%= f.number_field :tax_rate, step: "0.01", data: { "line-items-target": "taxRate", action: "input->line-items#recalculate" }, class: "w-24 rounded-lg border-slate-300 text-sm text-right focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div class="flex justify-between"><span class="text-slate-500">Tax</span><span class="font-medium text-slate-900" data-line-items-target="taxAmount">—</span></div>
          <div class="flex justify-between border-t border-slate-200 pt-3 text-base">
            <span class="font-semibold text-slate-900">Total</span>
            <span class="font-bold text-indigo-600" data-line-items-target="total">—</span>
          </div>
        </div>

        <div class="mt-5 space-y-2">
          <%= f.submit (invoice.persisted? ? "Save invoice" : "Create invoice"), class: "w-full rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
          <%= link_to "Cancel", (invoice.persisted? ? invoice : invoices_path), class: "block text-center rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %>
        </div>
      </div>

      <%# Recurring %>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= f.check_box :recurring, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
          <span class="text-sm font-medium text-slate-700">Make this a recurring invoice</span>
        </label>
        <p class="mt-1 text-xs text-slate-400">A new draft will be generated automatically each cycle.</p>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <div>
            <%= f.label :recurring_interval, "Every", class: "block text-xs font-medium text-slate-500 mb-1" %>
            <%= f.select :recurring_interval, Invoice.recurring_intervals.keys.map { |k| [k.titleize, k] }, { include_blank: "—" }, class: "w-full rounded-lg border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
          <div>
            <%= f.label :recurring_next_run, "Next run", class: "block text-xs font-medium text-slate-500 mb-1" %>
            <%= f.date_field :recurring_next_run, class: "w-full rounded-lg border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
