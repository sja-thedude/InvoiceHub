<% content_for :page_title, "Invoices" %>

<div class="space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h2 class="text-2xl font-bold text-slate-900">Invoices</h2>
      <p class="text-sm text-slate-500">Create, send and track every invoice.</p>
    </div>
    <%= link_to new_invoice_path, class: "inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
      <span class="w-4 h-4"><%= icon_svg(:plus, classes: "w-4 h-4").html_safe %></span> New Invoice
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "All", invoices_path, class: "rounded-full px-3 py-1 text-sm font-medium #{params[:status].blank? ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}" %>
    <% Invoice.statuses.each_key do |status| %>
      <%= link_to status.titleize, invoices_path(status: status), class: "rounded-full px-3 py-1 text-sm font-medium #{params[:status] == status ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}" %>
    <% end %>
  </div>

  <% if @invoices.any? %>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-5 py-3 text-left">Invoice</th>
              <th class="px-5 py-3 text-left">Client</th>
              <th class="px-5 py-3 text-left">Issued</th>
              <th class="px-5 py-3 text-left">Due</th>
              <th class="px-5 py-3 text-right">Total</th>
              <th class="px-5 py-3 text-right">Balance</th>
              <th class="px-5 py-3 text-center">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @invoices.each do |invoice| %>
              <tr class="hover:bg-slate-50 cursor-pointer" onclick="window.location='<%= invoice_path(invoice) %>'">
                <td class="px-5 py-3 font-medium text-indigo-600 whitespace-nowrap">
                  <%= invoice.invoice_number %>
                  <% if invoice.recurring? %><span title="Recurring" class="ml-1 text-purple-500">↻</span><% end %>
                </td>
                <td class="px-5 py-3 text-slate-700"><%= invoice.client.name %></td>
                <td class="px-5 py-3 text-slate-500 whitespace-nowrap"><%= invoice.issue_date&.strftime("%b %-d, %Y") %></td>
                <td class="px-5 py-3 whitespace-nowrap <%= invoice.overdue? ? 'text-red-600 font-medium' : 'text-slate-500' %>"><%= invoice.due_date&.strftime("%b %-d, %Y") %></td>
                <td class="px-5 py-3 text-right font-semibold text-slate-900 whitespace-nowrap"><%= money invoice.total, invoice.currency %></td>
                <td class="px-5 py-3 text-right text-slate-600 whitespace-nowrap"><%= money invoice.balance_due, invoice.currency %></td>
                <td class="px-5 py-3 text-center"><%= status_pill invoice.status, invoice.status_color %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="pt-2"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
  <% else %>
    <%= render "shared/empty_state", title: "No invoices yet", body: "Create your first invoice and get paid.", icon: :invoice, action_label: "Create invoice", action_path: new_invoice_path %>
  <% end %>
</div>
