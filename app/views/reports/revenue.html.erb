<% content_for :page_title, "Revenue by Month" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <%= link_to reports_path, class: "text-sm text-slate-500 hover:text-slate-700" do %>← All reports<% end %>
      <h2 class="text-2xl font-bold text-slate-900">Revenue by month</h2>
    </div>
    <%= form_with url: reports_revenue_path, method: :get, class: "flex items-center gap-2" do %>
      <%= select_tag :year, options_for_select(@years, @year), onchange: "this.form.requestSubmit()", class: "rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%= render "shared/stat_card", title: "Collected in #{@year}", value: money(@total), icon: :cash, accent: "emerald" %>
    <%= render "shared/stat_card", title: "Invoiced in #{@year}", value: money(@invoiced), icon: :invoice, accent: "indigo" %>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="font-semibold text-slate-900 mb-4">Monthly collected revenue — <%= @year %></h3>
    <% if @by_month.values.sum.to_d.positive? %>
      <%= column_chart @by_month, colors: ["#6366F1"], library: { borderRadius: 6 }, height: "320px", prefix: Money::Currency.new(current_user.default_currency).symbol, thousands: "," %>
    <% else %>
      <%= render "shared/empty_chart" %>
    <% end %>
  </div>
</div>
