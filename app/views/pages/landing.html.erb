<%# Top nav %>
<header class="absolute inset-x-0 top-0 z-10">
  <nav class="mx-auto max-w-7xl flex items-center justify-between p-6 lg:px-8">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg">I</div>
      <span class="text-white font-bold text-xl tracking-tight">Invoice<span class="text-indigo-300">Hub</span></span>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to "Sign in", new_user_session_path, class: "text-sm font-semibold text-white/90 hover:text-white px-3 py-2" %>
      <%= link_to "Get started", new_user_registration_path, class: "rounded-xl bg-white px-4 py-2 text-sm font-semibold text-indigo-700 shadow-sm hover:bg-indigo-50" %>
    </div>
  </nav>
</header>

<%# Hero %>
<section class="relative overflow-hidden bg-slate-900">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-900 via-slate-900 to-purple-900"></div>
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-indigo-500/20 blur-3xl"></div>
  <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-purple-500/20 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8 pt-36 pb-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-indigo-200 ring-1 ring-inset ring-white/20">
          ⚡ Built for freelancers &amp; solo studios
        </span>
        <h1 class="mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]">
          Invoicing that gets you <span class="bg-gradient-to-r from-indigo-300 to-purple-300 bg-clip-text text-transparent">paid faster</span>.
        </h1>
        <p class="mt-6 text-lg text-slate-300 max-w-xl">
          Create beautiful invoices, track time and expenses, accept online payments, and see exactly how your freelance business is performing — all in one place.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <%= link_to "Start free", new_user_registration_path, class: "rounded-xl bg-indigo-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/30 hover:bg-indigo-400" %>
          <%= link_to "Sign in", new_user_session_path, class: "rounded-xl bg-white/10 px-6 py-3 text-sm font-semibold text-white ring-1 ring-inset ring-white/20 hover:bg-white/20" %>
        </div>
        <div class="mt-8 flex items-center gap-6 text-sm text-slate-400">
          <span>✓ Professional PDF invoices</span>
          <span>✓ Stripe payments</span>
          <span>✓ Multi-currency</span>
        </div>
      </div>

      <%# Floating product preview card %>
      <div class="relative">
        <div class="rounded-2xl bg-white shadow-2xl ring-1 ring-slate-900/5 p-6 rotate-1 hover:rotate-0 transition-transform duration-300">
          <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Invoice</p>
              <p class="text-lg font-bold text-slate-900">INV-2026-0042</p>
            </div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">Paid</span>
          </div>
          <div class="py-4 space-y-2.5 text-sm">
            <div class="flex justify-between"><span class="text-slate-500">Brand identity design</span><span class="font-medium text-slate-900">$2,400.00</span></div>
            <div class="flex justify-between"><span class="text-slate-500">Landing page (12h)</span><span class="font-medium text-slate-900">$1,080.00</span></div>
            <div class="flex justify-between"><span class="text-slate-500">Consulting retainer</span><span class="font-medium text-slate-900">$800.00</span></div>
          </div>
          <div class="border-t border-slate-100 pt-4 flex justify-between items-center">
            <span class="text-sm text-slate-500">Total due</span>
            <span class="text-2xl font-bold text-slate-900">$4,280.00</span>
          </div>
        </div>
        <div class="absolute -bottom-6 -left-6 rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5 px-5 py-4 -rotate-3">
          <p class="text-xs text-slate-500">This month</p>
          <p class="text-xl font-bold text-emerald-600">+$12,840</p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# Features %>
<section class="py-24 bg-slate-50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">Everything you need to run the business side</h2>
      <p class="mt-4 text-slate-600">From the first quote to the final payment, InvoiceHub handles the busywork so you can focus on the work.</p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% [
        [:invoice, "Smart invoice builder", "Add line items, taxes and discounts with live totals. Generate polished PDFs in one click."],
        [:clock, "Time tracking", "Log billable hours per project and convert tracked time straight into invoice line items."],
        [:receipt, "Expense tracking", "Capture receipts, categorise spend and link expenses to projects for true profitability."],
        [:cash, "Online payments", "Let clients pay by card via Stripe. Payments are recorded and statuses update automatically."],
        [:repeat, "Recurring invoices", "Set weekly, monthly or quarterly schedules and let InvoiceHub draft them for you."],
        [:chart, "Reports & insights", "Revenue by month and client, project profitability and a tax summary for your accountant."]
      ].each do |icon, title, body| %>
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:shadow-md transition">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            <%= icon_svg(icon).html_safe %>
          </div>
          <h3 class="mt-4 font-semibold text-slate-900"><%= title %></h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed"><%= body %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# CTA %>
<section class="bg-indigo-600">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 py-16 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white">Ready to get paid faster?</h2>
    <p class="mt-3 text-indigo-100">Create your free account and send your first invoice in minutes.</p>
    <%= link_to "Get started — it's free", new_user_registration_path, class: "mt-8 inline-block rounded-xl bg-white px-6 py-3 text-sm font-semibold text-indigo-700 shadow-sm hover:bg-indigo-50" %>
  </div>
</section>

<footer class="bg-slate-900 py-8">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2 text-white/80">
      <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">I</div>
      <span class="font-semibold">InvoiceHub</span>
    </div>
    <p class="text-sm text-slate-400">© <%= Date.current.year %> InvoiceHub. Built with Ruby on Rails.</p>
  </div>
</footer>
