<%= form_with model: project, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", model: project %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :name, required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :client_id, "Client", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.collection_select :client_id, current_user.clients.alphabetical, :id, :name, { prompt: "Select a client" }, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :status, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :status, Project.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-3">
    <div>
      <%= f.label :hourly_rate, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :hourly_rate, step: "0.01", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :budget, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :budget, step: "0.01", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :currency, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :currency, currency_options, { selected: project.currency.presence || current_user.default_currency }, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Cancel", (project.persisted? ? project : projects_path), class: "rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %>
  </div>
<% end %>
