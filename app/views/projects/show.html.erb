<% content_for :page_title, @project.name %>

<div class="space-y-6">
  <%= link_to projects_path, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to projects<% end %>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <h2 class="text-2xl font-bold text-slate-900"><%= @project.name %></h2>
          <%= status_pill @project.status, @project.status_color %>
        </div>
        <p class="text-slate-500 mt-1"><%= link_to @project.client.name, @project.client, class: "hover:text-indigo-600" %> · <%= money @project.hourly_rate, @project.currency %>/hr</p>
        <% if @project.description.present? %><p class="mt-3 text-sm text-slate-600 max-w-2xl whitespace-pre-line"><%= @project.description %></p><% end %>
      </div>
      <div class="flex gap-2">
        <%= link_to "Log time", new_time_entry_path(project_id: @project.id), class: "rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
        <%= link_to "New invoice", new_invoice_path(client_id: @project.client_id, project_id: @project.id), class: "rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
        <%= link_to "Edit", edit_project_path(@project), class: "rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-2 sm:grid-cols-5 gap-4">
      <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Revenue</p><p class="text-lg font-bold text-emerald-600"><%= money_short @project.total_revenue, @project.currency %></p></div>
      <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Expenses</p><p class="text-lg font-bold text-red-600"><%= money_short @project.total_expenses, @project.currency %></p></div>
      <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Profit</p><p class="text-lg font-bold text-slate-900"><%= money_short @project.profit, @project.currency %></p></div>
      <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Hours</p><p class="text-lg font-bold text-slate-900"><%= @project.total_hours.to_f %></p></div>
      <div class="rounded-xl bg-slate-50 p-4"><p class="text-xs text-slate-400">Unbilled</p><p class="text-lg font-bold text-amber-600"><%= @project.unbilled_hours.to_f %>h</p></div>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="px-5 py-4 border-b border-slate-100"><h3 class="font-semibold text-slate-900">Invoices</h3></div>
      <% if @invoices.any? %>
        <ul class="divide-y divide-slate-100">
          <% @invoices.each do |invoice| %>
            <li>
              <%= link_to invoice, class: "flex items-center justify-between px-5 py-3 hover:bg-slate-50" do %>
                <div><p class="text-sm font-medium text-slate-900"><%= invoice.invoice_number %></p><p class="text-xs text-slate-400"><%= invoice.issue_date&.strftime("%b %-d, %Y") %></p></div>
                <div class="text-right"><p class="text-sm font-semibold text-slate-900"><%= money invoice.total, invoice.currency %></p><%= status_pill invoice.status, invoice.status_color %></div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-5 py-8 text-center text-sm text-slate-400">No invoices for this project yet.</p>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100"><h3 class="font-semibold text-slate-900">Recent time</h3><%= link_to "All", time_entries_path(project_id: @project.id), class: "text-sm text-indigo-600" %></div>
        <% if @time_entries.any? %>
          <ul class="divide-y divide-slate-100">
            <% @time_entries.each do |entry| %>
              <li class="flex items-center justify-between px-5 py-2.5 text-sm">
                <div class="min-w-0"><p class="font-medium text-slate-800 truncate"><%= entry.description %></p><p class="text-xs text-slate-400"><%= entry.date.strftime("%b %-d") %></p></div>
                <span class="font-semibold text-slate-900"><%= entry.hours.to_f %>h</span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="px-5 py-6 text-center text-sm text-slate-400">No time logged.</p>
        <% end %>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100"><h3 class="font-semibold text-slate-900">Recent expenses</h3><%= link_to "Add", new_expense_path(project_id: @project.id), class: "text-sm text-indigo-600" %></div>
        <% if @expenses.any? %>
          <ul class="divide-y divide-slate-100">
            <% @expenses.each do |expense| %>
              <li class="flex items-center justify-between px-5 py-2.5 text-sm">
                <div class="min-w-0"><p class="font-medium text-slate-800 truncate"><%= expense.icon %> <%= expense.description %></p><p class="text-xs text-slate-400"><%= expense.date.strftime("%b %-d") %></p></div>
                <span class="font-semibold text-red-600"><%= money expense.amount, expense.currency %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="px-5 py-6 text-center text-sm text-slate-400">No expenses.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <%= button_to "Delete project", @project, method: :delete, form: { data: { turbo_confirm: "Delete this project?" } }, class: "text-sm font-medium text-red-600 hover:text-red-700" %>
  </div>
</div>
