<% content_for :page_title, "Projects" %>

<div class="space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h2 class="text-2xl font-bold text-slate-900">Projects</h2>
      <p class="text-sm text-slate-500">Track work, rates and profitability per engagement.</p>
    </div>
    <%= link_to new_project_path, class: "inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
      <span class="w-4 h-4"><%= icon_svg(:plus, classes: "w-4 h-4").html_safe %></span> New Project
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "All", projects_path, class: "rounded-full px-3 py-1 text-sm font-medium #{params[:status].blank? ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}" %>
    <% Project.statuses.each_key do |status| %>
      <%= link_to status.titleize, projects_path(status: status), class: "rounded-full px-3 py-1 text-sm font-medium #{params[:status] == status ? 'bg-indigo-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}" %>
    <% end %>
  </div>

  <% if @projects.any? %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @projects.each do |project| %>
        <%= link_to project, class: "group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-200 transition flex flex-col" do %>
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0">
              <p class="font-semibold text-slate-900 truncate group-hover:text-indigo-600"><%= project.name %></p>
              <p class="text-xs text-slate-400 truncate"><%= project.client.name %></p>
            </div>
            <%= status_pill project.status, project.status_color %>
          </div>
          <p class="mt-3 text-sm text-slate-500 line-clamp-2 flex-1"><%= project.description.presence || "No description" %></p>
          <div class="mt-4 flex items-center justify-between text-sm border-t border-slate-100 pt-3">
            <span class="text-slate-500"><%= money project.hourly_rate, project.currency %>/hr</span>
            <span class="font-semibold text-slate-900"><%= money_short project.total_billed, project.currency %> billed</span>
          </div>
          <% if project.budget.to_d.positive? %>
            <div class="mt-3">
              <div class="flex justify-between text-xs text-slate-400 mb-1"><span>Budget</span><span><%= project.budget_used_percent %>%</span></div>
              <div class="h-1.5 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-full rounded-full <%= project.budget_used_percent > 100 ? 'bg-red-500' : 'bg-indigo-500' %>" style="width: <%= [project.budget_used_percent, 100].min %>%"></div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="pt-2"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
  <% else %>
    <%= render "shared/empty_state", title: "No projects yet", body: "Create a project to track hours, expenses and profitability.", icon: :folder, action_label: "New project", action_path: new_project_path %>
  <% end %>
</div>
