<% content_for :page_title, "New Project" %>
<div class="max-w-2xl mx-auto">
  <%= link_to projects_path, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to projects<% end %>
  <h2 class="mt-2 text-2xl font-bold text-slate-900">New Project</h2>
  <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <% if current_user.clients.none? %>
      <p class="text-sm text-slate-500">You need a client first. <%= link_to "Add a client", new_client_path, class: "text-indigo-600 font-medium" %>.</p>
    <% else %>
      <%= render "form", project: @project %>
    <% end %>
  </div>
</div>
