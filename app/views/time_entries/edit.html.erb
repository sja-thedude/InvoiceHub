<% content_for :page_title, "Edit Time Entry" %>
<div class="max-w-lg mx-auto">
  <%= link_to time_entries_path, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to time<% end %>
  <h2 class="mt-2 text-2xl font-bold text-slate-900">Edit time entry</h2>
  <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= render "form", time_entry: @time_entry %>
  </div>
</div>
