<%= form_with model: time_entry, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", model: time_entry %>
  <div>
    <%= f.label :project_id, "Project", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.collection_select :project_id, current_user.projects.includes(:client).order(:name), :id, ->(p) { "#{p.name} — #{p.client.name}" }, { prompt: "Select a project" }, required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :description, required: true, placeholder: "What did you work on?", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :hours, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :hours, step: "0.25", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :date, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.date_field :date, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>
  <label class="flex items-center gap-2 cursor-pointer">
    <%= f.check_box :billable, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
    <span class="text-sm font-medium text-slate-700">Billable</span>
  </label>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Cancel", time_entries_path, class: "rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %>
  </div>
<% end %>
