<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "InvoiceHub" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <div class="min-h-full lg:grid lg:grid-cols-2">
      <%# Left brand panel %>
      <div class="relative hidden lg:flex flex-col justify-between overflow-hidden bg-slate-900 p-12 text-white">
        <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-indigo-500/20 blur-3xl"></div>
        <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-purple-500/20 blur-3xl"></div>
        <%= link_to root_path, class: "relative flex items-center gap-2.5" do %>
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg">I</div>
          <span class="font-bold text-xl tracking-tight">Invoice<span class="text-indigo-300">Hub</span></span>
        <% end %>
        <div class="relative">
          <h2 class="text-3xl font-bold leading-tight">Invoicing that gets you paid faster.</h2>
          <p class="mt-4 text-slate-300 max-w-md">Beautiful invoices, time &amp; expense tracking, online payments and real-time insights — built for freelancers.</p>
          <div class="mt-8 flex gap-6 text-sm text-slate-400">
            <span>✓ PDF invoices</span><span>✓ Stripe payments</span><span>✓ Multi-currency</span>
          </div>
        </div>
        <p class="relative text-sm text-slate-500">© <%= Date.current.year %> InvoiceHub</p>
      </div>

      <%# Right form panel %>
      <div class="flex items-center justify-center px-6 py-12 bg-slate-50 lg:bg-white">
        <div class="w-full max-w-sm">
          <div class="lg:hidden mb-8 flex items-center gap-2.5">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg">I</div>
            <span class="font-bold text-xl text-slate-900">Invoice<span class="text-indigo-600">Hub</span></span>
          </div>
          <%= render "shared/flash" %>
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
