<%= form_with model: expense, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", model: expense %>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :description, required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :amount, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :amount, step: "0.01", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :currency, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :currency, currency_options, { selected: expense.currency.presence || current_user.default_currency }, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :category, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :category, Expense.categories.keys.map { |c| [c.titleize, c] }, {}, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :date, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.date_field :date, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>
  <div>
    <%= f.label :project_id, "Project (optional)", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.collection_select :project_id, current_user.projects.includes(:client).order(:name), :id, ->(p) { "#{p.name} — #{p.client.name}" }, { include_blank: "No project" }, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :receipt, "Receipt (optional)", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <% if expense.receipt.attached? %>
      <p class="text-xs text-slate-500 mb-1">Current: <%= link_to expense.receipt.filename, url_for(expense.receipt), target: "_blank", class: "text-indigo-600" %></p>
    <% end %>
    <%= f.file_field :receipt, accept: "image/*,application/pdf", class: "block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" %>
  </div>
  <label class="flex items-center gap-2 cursor-pointer">
    <%= f.check_box :billable, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
    <span class="text-sm font-medium text-slate-700">Billable to client</span>
  </label>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Cancel", expenses_path, class: "rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %>
  </div>
<% end %>
