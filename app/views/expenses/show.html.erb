<% content_for :page_title, @expense.description %>
<div class="max-w-lg mx-auto space-y-5">
  <%= link_to expenses_path, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to expenses<% end %>
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-start justify-between">
      <div>
        <h2 class="text-xl font-bold text-slate-900"><%= @expense.icon %> <%= @expense.description %></h2>
        <p class="text-sm text-slate-500"><%= @expense.category.titleize %> · <%= @expense.date.strftime("%B %-d, %Y") %></p>
      </div>
      <p class="text-2xl font-bold text-slate-900"><%= money @expense.amount, @expense.currency %></p>
    </div>
    <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
      <div><dt class="text-slate-400">Project</dt><dd class="font-medium text-slate-800"><%= @expense.project&.name || "—" %></dd></div>
      <div><dt class="text-slate-400">Billable</dt><dd class="font-medium text-slate-800"><%= @expense.billable? ? "Yes" : "No" %></dd></div>
    </dl>
    <% if @expense.receipt.attached? %>
      <div class="mt-5">
        <p class="text-sm font-semibold text-slate-900 mb-2">Receipt</p>
        <% if @expense.receipt.image? %>
          <%= image_tag url_for(@expense.receipt), class: "rounded-xl border border-slate-200 max-h-96" %>
        <% else %>
          <%= link_to "Open receipt (#{@expense.receipt.filename})", url_for(@expense.receipt), target: "_blank", class: "text-indigo-600 font-medium" %>
        <% end %>
      </div>
    <% end %>
    <div class="mt-6 flex gap-3">
      <%= link_to "Edit", edit_expense_path(@expense), class: "rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      <%= button_to "Delete", @expense, method: :delete, form: { data: { turbo_confirm: "Delete expense?" } }, class: "rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-50" %>
    </div>
  </div>
</div>
