<div style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; max-width: 560px; margin: 0 auto; color: #1e293b;">
  <div style="background: #059669; padding: 28px 32px; border-radius: 14px 14px 0 0;">
    <h1 style="color: #fff; margin: 0; font-size: 20px;">Payment received ✓</h1>
  </div>
  <div style="border: 1px solid #e2e8f0; border-top: none; padding: 32px; border-radius: 0 0 14px 14px;">
    <p style="font-size: 15px;">Hi <%= @client.name %>,</p>
    <p style="font-size: 15px; line-height: 1.6; color: #475569;">
      We've recorded your payment of
      <strong><%= Money.from_amount(@payment.amount, @invoice.currency).format %></strong>
      for invoice <strong><%= @invoice.invoice_number %></strong> on
      <%= @payment.payment_date.strftime("%B %-d, %Y") %>.
    </p>
    <p style="font-size: 15px; color: #475569;">
      Remaining balance:
      <strong><%= Money.from_amount(@invoice.balance_due, @invoice.currency).format %></strong>
    </p>
    <p style="font-size: 14px; color: #475569;">Thank you,<br><%= @user.display_name %></p>
  </div>
</div>
