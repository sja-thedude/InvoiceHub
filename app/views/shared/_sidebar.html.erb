<%# Mobile backdrop %>
<div data-sidebar-target="backdrop" data-action="click->sidebar#close"
     class="fixed inset-0 z-30 bg-slate-900/50 backdrop-blur-sm lg:hidden hidden"></div>

<aside data-sidebar-target="panel"
       class="fixed inset-y-0 left-0 z-40 w-64 bg-slate-900 flex flex-col -translate-x-full lg:translate-x-0 lg:static lg:flex transition-transform duration-200 ease-in-out">
  <%# Brand %>
  <div class="h-16 flex items-center gap-2.5 px-5 border-b border-slate-800">
    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg">I</div>
    <span class="text-white font-bold text-lg tracking-tight">Invoice<span class="text-indigo-400">Hub</span></span>
  </div>

  <%# Nav %>
  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
    <p class="px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Overview</p>
    <%= nav_link_to "Dashboard", dashboard_path, icon: icon_svg(:dashboard), exact: true %>

    <p class="px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 mt-5 mb-2">Billing</p>
    <%= nav_link_to "Invoices", invoices_path, icon: icon_svg(:invoice) %>
    <%= nav_link_to "Clients", clients_path, icon: icon_svg(:users) %>
    <%= nav_link_to "Projects", projects_path, icon: icon_svg(:folder) %>

    <p class="px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 mt-5 mb-2">Tracking</p>
    <%= nav_link_to "Time", time_entries_path, icon: icon_svg(:clock) %>
    <%= nav_link_to "Expenses", expenses_path, icon: icon_svg(:receipt) %>

    <p class="px-3 text-xs font-semibold uppercase tracking-wider text-slate-500 mt-5 mb-2">Insights</p>
    <%= nav_link_to "Reports", reports_path, icon: icon_svg(:chart) %>
  </nav>

  <%# Account %>
  <div class="border-t border-slate-800 p-3">
    <%= link_to profile_path, class: "flex items-center gap-3 px-2 py-2 rounded-xl hover:bg-slate-800 transition group" do %>
      <%= avatar_initials current_user.display_name, classes: "w-9 h-9 text-xs" %>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-white truncate"><%= current_user.display_name %></p>
        <p class="text-xs text-slate-400 truncate"><%= current_user.email %></p>
      </div>
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete,
          class: "mt-1 w-full flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-white transition" do %>
      <span class="w-5 h-5"><%= icon_svg(:logout).html_safe %></span>
      Sign out
    <% end %>
  </div>
</aside>
