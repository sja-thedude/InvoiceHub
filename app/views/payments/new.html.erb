<% content_for :page_title, "Record Payment" %>
<div class="max-w-lg mx-auto">
  <%= link_to @invoice, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to <%= @invoice.invoice_number %><% end %>
  <h2 class="mt-2 text-2xl font-bold text-slate-900">Record a payment</h2>
  <p class="text-sm text-slate-500">For invoice <%= @invoice.invoice_number %> · balance due <strong><%= money @invoice.balance_due, @invoice.currency %></strong></p>

  <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: [@invoice, @payment], url: invoice_payments_path(@invoice), class: "space-y-5" do |f| %>
      <%= render "shared/form_errors", model: @payment %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :amount, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :amount, step: "0.01", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :payment_date, "Date", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.date_field :payment_date, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :payment_method, "Method", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.select :payment_method, Payment.payment_methods.keys.map { |m| [m.titleize, m] }, {}, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :reference, "Reference", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :reference, placeholder: "e.g. transfer ref", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
      </div>
      <div>
        <%= f.label :notes, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :notes, rows: 2, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit "Record payment", class: "rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 cursor-pointer" %>
        <%= link_to "Cancel", @invoice, class: "rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %>
      </div>
    <% end %>
  </div>
</div>
