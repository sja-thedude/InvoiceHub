<% content_for :page_title, "#{@client.name} — History" %>

<div class="space-y-6">
  <%= link_to @client, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to <%= @client.name %><% end %>
  <h2 class="text-2xl font-bold text-slate-900">Billing history</h2>

  <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100"><h3 class="font-semibold text-slate-900">Invoices</h3></div>
    <% if @invoices.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-100 text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
            <tr>
              <th class="px-5 py-3 text-left">Invoice</th>
              <th class="px-5 py-3 text-left">Project</th>
              <th class="px-5 py-3 text-left">Issued</th>
              <th class="px-5 py-3 text-left">Due</th>
              <th class="px-5 py-3 text-right">Total</th>
              <th class="px-5 py-3 text-center">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @invoices.each do |invoice| %>
              <tr class="hover:bg-slate-50 cursor-pointer" onclick="window.location='<%= invoice_path(invoice) %>'">
                <td class="px-5 py-3 font-medium text-indigo-600"><%= invoice.invoice_number %></td>
                <td class="px-5 py-3 text-slate-600"><%= invoice.project&.name || "—" %></td>
                <td class="px-5 py-3 text-slate-600"><%= invoice.issue_date&.strftime("%b %-d, %Y") %></td>
                <td class="px-5 py-3 text-slate-600"><%= invoice.due_date&.strftime("%b %-d, %Y") %></td>
                <td class="px-5 py-3 text-right font-semibold text-slate-900"><%= money invoice.total, invoice.currency %></td>
                <td class="px-5 py-3 text-center"><%= status_pill invoice.status, invoice.status_color %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-5 py-10 text-center text-sm text-slate-400">No invoices for this client yet.</p>
    <% end %>
  </div>

  <% if @payments.any? %>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100"><h3 class="font-semibold text-slate-900">Payments</h3></div>
      <ul class="divide-y divide-slate-100">
        <% @payments.each do |payment| %>
          <li class="flex items-center justify-between px-5 py-3 text-sm">
            <div>
              <p class="font-medium text-slate-900"><%= payment.invoice.invoice_number %></p>
              <p class="text-xs text-slate-400"><%= payment.payment_method.titleize %> · <%= payment.payment_date.strftime("%b %-d, %Y") %></p>
            </div>
            <span class="font-semibold text-emerald-600">+<%= money payment.amount, payment.invoice.currency %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
