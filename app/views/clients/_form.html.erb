<%= form_with model: client, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", model: client %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name, required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :company, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :company, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.email_field :email, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :phone, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.telephone_field :phone, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
  </div>

  <div>
    <%= f.label :address, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_area :address, rows: 3, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, placeholder: "Internal notes (not shown on invoices)", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Cancel", (client.persisted? ? client : clients_path), class: "rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %>
  </div>
<% end %>
