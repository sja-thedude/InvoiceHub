<% content_for :title, "Change password · InvoiceHub" %>

<h1 class="text-2xl font-bold text-slate-900">Choose a new password</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-8 space-y-4" }) do |f| %>
  <%= f.hidden_field :reset_password_token %>
  <% if resource.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% resource.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <%= f.submit "Change password", class: "w-full rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
<% end %>
