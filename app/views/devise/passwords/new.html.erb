<% content_for :title, "Reset password · InvoiceHub" %>

<h1 class="text-2xl font-bold text-slate-900">Reset your password</h1>
<p class="mt-1 text-sm text-slate-500">We'll email you a link to set a new one.</p>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-4" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <%= f.submit "Send reset link", class: "w-full rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
<% end %>

<p class="mt-6 text-center text-sm text-slate-500">
  <%= link_to "Back to sign in", new_session_path(resource_name), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
</p>
