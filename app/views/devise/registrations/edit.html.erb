<% content_for :title, "Account · InvoiceHub" %>

<h1 class="text-2xl font-bold text-slate-900">Account &amp; password</h1>
<p class="mt-1 text-sm text-slate-500">Update your sign-in email or password.</p>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-8 space-y-4" }) do |f| %>
  <% if resource.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <ul class="list-disc list-inside">
        <% resource.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: "Leave blank to keep current", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :current_password, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Required to save changes", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <%= f.submit "Update", class: "w-full rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
<% end %>

<div class="mt-6 flex items-center justify-between text-sm">
  <%= link_to "← Back to app", root_path, class: "text-slate-500 hover:text-slate-700" %>
  <%= button_to "Delete account", registration_path(resource_name), method: :delete, form: { data: { turbo_confirm: "This deletes your account and all data. Continue?" } }, class: "font-medium text-red-600 hover:text-red-700" %>
</div>
