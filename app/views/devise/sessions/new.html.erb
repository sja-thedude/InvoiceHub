<% content_for :title, "Sign in · InvoiceHub" %>

<h1 class="text-2xl font-bold text-slate-900">Welcome back</h1>
<p class="mt-1 text-sm text-slate-500">Sign in to your InvoiceHub account.</p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-4" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div>
    <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>
  <div class="flex items-center justify-between">
    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <%= f.check_box :remember_me, class: "rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %> Remember me
      </label>
    <% end %>
    <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </div>
  <%= f.submit "Sign in", class: "w-full rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
<% end %>

<p class="mt-6 text-center text-sm text-slate-500">
  New to InvoiceHub? <%= link_to "Create an account", new_registration_path(resource_name), class: "font-semibold text-indigo-600 hover:text-indigo-500" %>
</p>
