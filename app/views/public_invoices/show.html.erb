<% content_for :title, "Invoice #{@invoice.invoice_number} · #{@user.display_name}" %>

<div class="min-h-screen bg-slate-100 py-10 px-4">
  <div class="max-w-2xl mx-auto">
    <%# Pay bar %>
    <div class="rounded-2xl bg-white shadow-sm border border-slate-200 p-5 mb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="text-sm text-slate-500">Amount due</p>
        <p class="text-2xl font-bold text-slate-900"><%= Money.from_amount(@invoice.balance_due, @invoice.currency).format %></p>
        <p class="text-xs text-slate-400">Due <%= @invoice.due_date&.strftime("%B %-d, %Y") %></p>
      </div>
      <div class="flex gap-2">
        <%= link_to "Download PDF", pdf_invoice_path(@invoice), class: "rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
        <% if @invoice.paid_in_full? %>
          <span class="rounded-xl bg-emerald-100 px-4 py-2.5 text-sm font-semibold text-emerald-700">Paid in full ✓</span>
        <% elsif @stripe_enabled %>
          <%= button_to "Pay now", checkouts_path(token: @invoice.public_token), class: "rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
        <% else %>
          <span class="rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-medium text-slate-500" title="Bank transfer details are on the invoice">Pay by transfer</span>
        <% end %>
      </div>
    </div>

    <%# Invoice document %>
    <div class="rounded-2xl bg-white shadow-sm border border-slate-200 overflow-hidden">
      <div class="h-2 bg-gradient-to-r from-indigo-500 to-purple-600"></div>
      <div class="p-6 sm:p-10">
        <div class="flex items-start justify-between gap-6">
          <div>
            <% if @user.logo.attached? %>
              <%= image_tag @user.logo.variant(resize_to_limit: [160, 80]), class: "h-12 w-auto mb-3" %>
            <% end %>
            <h1 class="text-lg font-bold text-slate-900"><%= @user.display_name %></h1>
            <p class="text-sm text-slate-500 whitespace-pre-line"><%= @user.business_address %></p>
          </div>
          <div class="text-right">
            <p class="text-2xl font-bold text-indigo-600">INVOICE</p>
            <p class="text-slate-500"><%= @invoice.invoice_number %></p>
            <span class="mt-1 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= @invoice.status_color %>"><%= @invoice.status.titleize %></span>
          </div>
        </div>

        <div class="mt-8 grid sm:grid-cols-2 gap-6 text-sm">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Bill to</p>
            <p class="mt-1 font-semibold text-slate-900"><%= @invoice.client.name %></p>
            <p class="text-slate-500 whitespace-pre-line"><%= @invoice.client.address %></p>
          </div>
          <div class="sm:text-right space-y-1">
            <p class="text-slate-500">Issued: <span class="font-medium text-slate-900"><%= @invoice.issue_date&.strftime("%b %-d, %Y") %></span></p>
            <p class="text-slate-500">Due: <span class="font-medium text-slate-900"><%= @invoice.due_date&.strftime("%b %-d, %Y") %></span></p>
          </div>
        </div>

        <div class="mt-8 overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead><tr class="bg-slate-900 text-white text-xs uppercase tracking-wider">
              <th class="px-4 py-2.5 text-left rounded-l-lg">Description</th>
              <th class="px-4 py-2.5 text-right">Qty</th>
              <th class="px-4 py-2.5 text-right">Price</th>
              <th class="px-4 py-2.5 text-right rounded-r-lg">Amount</th>
            </tr></thead>
            <tbody class="divide-y divide-slate-100">
              <% @invoice.invoice_items.each do |item| %>
                <tr>
                  <td class="px-4 py-3 text-slate-700"><%= item.description %></td>
                  <td class="px-4 py-3 text-right text-slate-500"><%= item.quantity.to_f %></td>
                  <td class="px-4 py-3 text-right text-slate-500"><%= Money.from_amount(item.unit_price, @invoice.currency).format %></td>
                  <td class="px-4 py-3 text-right font-medium text-slate-900"><%= Money.from_amount(item.total, @invoice.currency).format %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-6 flex justify-end">
          <div class="w-full sm:w-64 space-y-2 text-sm">
            <div class="flex justify-between"><span class="text-slate-500">Subtotal</span><span class="font-medium"><%= Money.from_amount(@invoice.subtotal, @invoice.currency).format %></span></div>
            <% if @invoice.discount.to_d.positive? %><div class="flex justify-between"><span class="text-slate-500">Discount</span><span>- <%= Money.from_amount(@invoice.discount, @invoice.currency).format %></span></div><% end %>
            <% if @invoice.tax_rate.to_d.positive? %><div class="flex justify-between"><span class="text-slate-500">Tax</span><span><%= Money.from_amount(@invoice.tax_amount, @invoice.currency).format %></span></div><% end %>
            <div class="flex justify-between border-t border-slate-200 pt-2 text-base"><span class="font-bold text-slate-900">Total</span><span class="font-bold text-indigo-600"><%= Money.from_amount(@invoice.total, @invoice.currency).format %></span></div>
          </div>
        </div>

        <% if @user.bank_details.present? %>
          <div class="mt-8 border-t border-slate-100 pt-6 text-sm">
            <p class="font-semibold text-slate-900 mb-1">Payment details</p>
            <p class="text-slate-500 whitespace-pre-line"><%= @user.bank_details %></p>
          </div>
        <% end %>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-slate-400">Powered by InvoiceHub</p>
  </div>
</div>
