<% content_for :page_title, "Edit Profile" %>

<div class="max-w-3xl mx-auto space-y-5">
  <%= link_to profile_path, class: "text-sm text-slate-500 hover:text-slate-700" do %>← Back to profile<% end %>
  <h2 class="text-2xl font-bold text-slate-900">Edit business profile</h2>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-5" do |f| %>
      <%= render "shared/form_errors", model: @user %>

      <div>
        <%= f.label :logo, "Business logo", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <div class="flex items-center gap-4">
          <% if @user.logo.attached? %>
            <%= image_tag @user.logo.variant(resize_to_limit: [96, 96]), class: "h-16 w-16 rounded-xl object-contain border border-slate-200 bg-white p-1" %>
          <% end %>
          <%= f.file_field :logo, accept: "image/*", class: "block text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" %>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :name, "Your name", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :name, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :business_name, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :business_name, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :phone, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.telephone_field :phone, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :website, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.url_field :website, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :tax_id, "Tax ID / VAT", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :tax_id, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :default_currency, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.select :default_currency, currency_options, { selected: @user.default_currency }, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :invoice_prefix, class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.text_field :invoice_prefix, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= f.label :payment_terms_days, "Payment terms (days)", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.number_field :payment_terms_days, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
      </div>

      <div>
        <%= f.label :business_address, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :business_address, rows: 3, class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= f.label :bank_details, "Bank / payment details (shown on invoices)", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_area :bank_details, rows: 4, placeholder: "Account name, IBAN/account number, PayPal, etc.", class: "w-full rounded-xl border-slate-300 text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save profile", class: "rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
        <%= link_to "Cancel", profile_path, class: "rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %>
      </div>
    <% end %>
  </div>
</div>
